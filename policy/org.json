{
  "version": 1,
  "notes": "Org default routing. First available target wins; later ones are fallbacks. Tune from `factory.ledger.stats()`. Override per user in ~/.orchestrate/policy.json or per repo in .orchestrate/policy.json (a role entry there replaces this role's targets). Top tier: claude-opus-5-5 and gpt-6.1-sol. Fable and Astra are reserved for specific scenarios; add them per repo or per run, not here. OpenCode models bill at API prices: keep them out of defaults; opt in per repo or run.",
  "roles": {
    "product-manager": {
      "targets": [
        {
          "providerInstanceId": "claudeAgent",
          "model": "claude-sonnet-5-5",
          "options": {
            "effort": "high"
          }
        },
        {
          "providerInstanceId": "codex",
          "model": "gpt-6.1-sol",
          "options": {
            "reasoningEffort": "high"
          }
        }
      ]
    },
    "context-curator": {
