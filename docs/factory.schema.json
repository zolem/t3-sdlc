{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "t3-sdlc repo contract (.orchestrate/factory.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "setup": { "type": "string", "minLength": 1, "description": "Installs dependencies in a fresh checkout. Re-runs only when a lockfile changes." },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "Commands that must all exit 0 on a committed HEAD before a slice can be reviewed. Use `orchestrate check <name>` for built-ins.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "run": { "type": "string", "minLength": 1 },
          "timeoutSec": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["up"],
      "anyOf": [{ "required": ["url"] }, { "required": ["urlPattern"] }],
      "description": "How to serve the app for browser validation. {port} is replaced with a free port in up, url and env.",
      "properties": {
        "up": { "type": "string", "minLength": 1 },
        "down": { "type": "string" },
        "url": { "type": "string" },
        "urlPattern": { "type": "string", "description": "Regex with one capture group, matched against the app output, when the URL is printed rather than known." },
        "ready": { "type": "string", "description": "Path polled until it answers (default /)." },
        "readyTimeoutSec": { "type": "integer", "minimum": 1 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "dir": { "type": "string", "description": "Where feature docs are written (default docs/features)." } }
    },
    "context": { "type": "object", "description": "Reserved for context hints." }
  }
}
